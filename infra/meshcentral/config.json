{
  "$schema": "https://raw.githubusercontent.com/Ylianst/MeshCentral/master/meshcentral-config-schema.json",
  "__comment__": "MeshCentral config for the Tee24 remote-support server on Fly.io. Fly terminates TLS at its edge and forwards plain HTTP to port 8080, so tlsOffload is on and certUrl points back at the public hostname so agents learn the real certificate.",
  "settings": {
    "cert": "remote.tee24.golf",
    "port": 8080,
    "aliasPort": 443,
    "redirPort": 0,
    "tlsOffload": true,
    "cookieIpCheck": false,
    "AgentPong": 120,
    "SelfUpdate": false,
    "AllowFraming": true,
    "allowLoginToken": true,
    "WebRTC": false,
    "plugins": { "enabled": false },
    "autoBackup": {
      "backupIntervalHours": 24,
      "keepLastDaysBackup": 7
    }
  },
  "domains": {
    "": {
      "title": "Tee24 Remote Support",
      "title2": "Bay computers",
      "newAccounts": false,
      "minify": true,
      "certUrl": "https://remote.tee24.golf:443",
      "allowedOrigin": false,
      "localSessionRecording": false,
      "agentInviteCodes": false,
      "agentNoProxy": true,
      "footer": "Tee24 bay computers only."
    }
  }
}
